# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rcip

# Backend
PORT=3001
JWT_SECRET=your-jwt-secret-here

# NLP Engine
NLP_ENGINE_URL=http://localhost:3002

# AI API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Elasticsearch (optional)
ELASTICSEARCH_URL=http://localhost:9200

# Weekly brief (optional — defaults shown; all are optional)
# CRON_WEEKLY_BRIEF=0 8 * * 1               # 매주 월 08:00 KST 자동 발행 (DISABLE_SCHEDULER=true 이면 크론/캐치업 꺼짐, 관리자 수동 생성은 동작)
# WEEKLY_BRIEF_ON_STARTUP=true              # 기동 캐치업: 지난주 브리프가 없고 월요일 08:00 KST 이후일 때만
# WEEKLY_BRIEF_STARTUP_DELAY_SEC=900
# WEEKLY_BRIEF_MIN_GAP_HOURS=12             # 마지막 시도 후 이 시간 안에는 캐치업 생략
# WEEKLY_BRIEF_MODEL=                       # 미설정이면 TECH_TREND_REPORT_MODEL → 기본 종합 모델
# WEEKLY_BRIEF_AI_ENABLED=true              # false 면 규칙 문장만 사용 (partial + ai_disabled)
# WEEKLY_BRIEF_SHOW_ARTICLE_SUMMARY=true    # false 면 기사 요약 1줄 비노출
# CLAUDE_MONTHLY_LIMIT_USD=50               # 월 예산 한도 (초과 시 AI 건너뛰고 규칙 문장)

# ARGOS_I daily snapshot export (backend service). Only ARGOS_I_EXPORT_TOKEN is required; everything else is optional.
# 문서: docs/argos-i-interface.md  /  샘플 pull 스크립트: scripts/argos-i-pull.mjs, scripts/argos-i-pull.sh
# ARGOS_I_EXPORT_TOKEN=<generate with openssl rand -hex 32>   # 필수. 32자 이상. 미설정/32자 미만이면 /api/argos-i/* 가 503 으로 비활성 (Railway: backend 서비스 Variables 에만 설정, 저장소에 커밋 금지)
# ARGOS_I_EXPORT_TOKEN_NEXT=<new token for zero-downtime rotation>  # 선택. 설정하면 두 토큰 중 하나만 맞아도 통과 (교체 후 제거)
# CRON_ARGOS_I_EXPORT=0 7 * * *             # 매일 07:00 KST 번들 생성 (DISABLE_SCHEDULER=true 이면 크론/캐치업 꺼짐, 관리자 수동 생성은 동작)
# ARGOS_I_EXPORT_ON_STARTUP=true            # 기동 캐치업: 07:00 KST 이후이고 오늘 번들이 없을 때만
# ARGOS_I_EXPORT_STARTUP_DELAY_SEC=300
# ARGOS_I_EXPORT_MIN_GAP_HOURS=3            # 마지막 시도 후 이 시간 안에는 캐치업 생략
# ARGOS_I_EXPORT_RETENTION_DAYS=30          # 보존 일수 (7~90)
# ARGOS_I_EXPORT_MAX_BUNDLE_MB=100          # 번들 크기 상한 (초과하면 저장하지 않고 실패 처리)
# ARGOS_I_EXPORT_TIMEOUT_MIN=10             # 한 번 생성의 전체 상한
# ARGOS_I_EXPORT_BUSY_WAIT_MIN=30           # 상류 작업(태깅·분석 파이프라인)이 돌 때 기다리는 최대 시간

# ARGOS_I initial full-DB dump (1회성 초기 적재용, 원문 포함 — 문서 14절). 같은 ARGOS_I_EXPORT_TOKEN 을 쓴다. 사용 후 제거 또는 false 권장
# ARGOS_I_FULL_DB_ENABLED=false             # true 일 때만 GET /api/argos-i/export/full-db.zip 이 동작 (기본 꺼짐). full-db/manifest 는 항상 응답
# ARGOS_I_FULL_DB_BATCH_ROWS=1000           # 커서 한 번에 가져오는 최대 행 수 (100~5000). 바이트 목표 1MiB 와 중 작은 쪽
# ARGOS_I_FULL_DB_TIMEOUT_MIN=60            # 한 덤프의 전체 상한 (5~240분)
# ARGOS_I_FULL_DB_ZIP_LEVEL=6               # deflate 레벨 (0~9, 0 이면 무압축)
