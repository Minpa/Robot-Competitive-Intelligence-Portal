# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rcip

# Backend
PORT=3001
JWT_SECRET=your-jwt-secret-here

# NLP Engine
NLP_ENGINE_URL=http://localhost:3002

# AI API Keys
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Elasticsearch (optional)
ELASTICSEARCH_URL=http://localhost:9200

# Weekly brief (optional — defaults shown; all are optional)
# CRON_WEEKLY_BRIEF=0 8 * * 1               # 매주 월 08:00 KST 자동 발행 (DISABLE_SCHEDULER=true 이면 크론/캐치업 꺼짐, 관리자 수동 생성은 동작)
# WEEKLY_BRIEF_ON_STARTUP=true              # 기동 캐치업: 지난주 브리프가 없고 월요일 08:00 KST 이후일 때만
# WEEKLY_BRIEF_STARTUP_DELAY_SEC=900
# WEEKLY_BRIEF_MIN_GAP_HOURS=12             # 마지막 시도 후 이 시간 안에는 캐치업 생략
# WEEKLY_BRIEF_MODEL=                       # 미설정이면 TECH_TREND_REPORT_MODEL → 기본 종합 모델
# WEEKLY_BRIEF_AI_ENABLED=true              # false 면 규칙 문장만 사용 (partial + ai_disabled)
# WEEKLY_BRIEF_SHOW_ARTICLE_SUMMARY=true    # false 면 기사 요약 1줄 비노출
# CLAUDE_MONTHLY_LIMIT_USD=50               # 월 예산 한도 (초과 시 AI 건너뛰고 규칙 문장)
